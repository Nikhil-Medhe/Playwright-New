# Environment (dev | stage | prod | local). Affects default baseURL.
ENV=stage

# Override base URL (optional)
# BASE_URL=https://tools.cn-qam-stage.catnav.us
# Public catalog base URL (optional)
# PUB_CATALOG_URL=https://nikhil.cn-qam-pub.catnav.us
# Quick switch without editing .env:
# npm run test:qam
# npm run test:prod
#
# Individual test QAM vs Prod + email/config map: see RUN_TESTS.md

# Playwright
# Cad Site Version catalog: default pub. Use stage catalog from WM if needed.
# CAD_CATALOG_URL=https://nikhil.cn-qam-stage.catnav.us
# Parallel workers (local default in config is 2 if unset — stable on typical PCs). Raise if machine is strong: PLAYWRIGHT_WORKERS=4
# PLAYWRIGHT_WORKERS=2
# Browser: locally the window is visible by default (not CI). Use HEADLESS=true for background.
# Always show browser even if HEADLESS=true below:
# PLAYWRIGHT_HEADED=true
# Chrome / Edge / Firefox: maximized-style window by default. Fixed viewport: PLAYWRIGHT_MAXIMIZE=false
# Run one browser: npx playwright test --project=chrome (or edge, firefox). Install: npx playwright install chrome msedge
# Chunky heading fonts still wrong in Chrome? Blocks remote @font-face (fallback to Arial/etc.; may affect icon fonts): PLAYWRIGHT_DISABLE_REMOTE_WEB_FONTS=true
# HEADLESS=true
# HEADLESS=false
# TIMEOUT=30000
# SLOW_MO=500

# Credentials: JSON array of { company, username, password } or path to file
# LOGIN_USERS=[{"company":"x","username":"y","password":"z"}]
# LOGIN_USERS_FILE=Data/credentials.json
#
# Automationqa company (prod) — copy lines below into .env when running their tests:
# LOGIN_USERS_FILE=Data/automationqa-credentials.json
# PUB_CATALOG_URL=https://YOUR-COMPANY.thomasnet-navigator.com
# BASE_URL=https://tools.thomasnet-navigator.com
# ENV=prod

# Test data directory (default: ./Data)
# DATA_DIR=./Data

# orderManager.spec.ts — thank-you order reference (optional if cadSiteVersion1 wrote test-results/last-order-ref.txt)
# ORDER_REF=60

# Payment on checkout Step 2: cod | stripe | auto (default auto = COD first, Stripe fallback)
# PAYMENT_METHOD=auto

# Tag filter (playwright.config): PLAYWRIGHT_GREP=@smoke  PLAYWRIGHT_GREP_INVERT=@flaky
# CI retries: PLAYWRIGHT_RETRIES=1

# Local run → email (for npm run test:email). Gmail: use App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=automation.qa.reports@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_TO=nikhil.medhe@firstsource.com
# Optional CC: multiple addresses comma-separated (no spaces, or spaces only after commas)
# EMAIL_CC=teammate1@company.com,teammate2@company.com
# Optional email text overrides (see scripts/send-result-email.js):
# EMAIL_SUBJECT_PREFIX=Playwright Automation Result
# EMAIL_BODY_HEADER=Thomas Navigator – automated run
# EMAIL_BODY_FOOTER=Contact QA team for questions.
