# Environment (dev | stage | prod | local). Affects default baseURL.
ENV=stage

# Override base URL (optional)
# BASE_URL=https://tools.cn-qam-stage.catnav.us

# Playwright
# Cad Site Version catalog: default pub. Use stage catalog from WM if needed.
# CAD_CATALOG_URL=https://nikhil.cn-qam-stage.catnav.us
# Browser: locally the window is visible by default (not CI). Use HEADLESS=true for background.
# Always show browser even if HEADLESS=true below:
# PLAYWRIGHT_HEADED=true
# Chromium: start maximized + full viewport (default on). To disable: PLAYWRIGHT_MAXIMIZE=false
# HEADLESS=true
# HEADLESS=false
# TIMEOUT=30000
# SLOW_MO=500

# Credentials: JSON array of { company, username, password } or path to file
# LOGIN_USERS=[{"company":"x","username":"y","password":"z"}]
# LOGIN_USERS_FILE=Data/credentials.json

# Test data directory (default: ./Data)
# DATA_DIR=./Data

# orderManager.spec.ts — thank-you order reference (optional if cadSiteVersion1 wrote test-results/last-order-ref.txt)
# ORDER_REF=60

# Local run → email (for npm run test:email). Gmail: use App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=automation.qa.reports@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_TO=nikhil.medhe@firstsource.com
